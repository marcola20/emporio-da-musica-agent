# Copy this file to .env and fill in your key:  cp .env.example .env
#
# The agent talks to any OpenAI-compatible Chat Completions endpoint.
# Default: Google Gemini (free API key at https://aistudio.google.com/apikey).
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
# gemini-3.5-flash gives richer answers, but its free tier allows only ~20 requests/day
# (each customer message uses 1-3); use it with billing enabled on your Google project.

# Other providers work by changing the three variables above, e.g.:
#   OpenAI:  LLM_BASE_URL=https://api.openai.com/v1/   LLM_MODEL=<an OpenAI chat model>
#   Ollama:  LLM_BASE_URL=http://localhost:11434/v1/   LLM_MODEL=<a local model>  LLM_API_KEY=ollama

# Optional: pin "today" (YYYY-MM-DD or YYYY-MM-DDTHH:MM) for reproducible runs.
# Leave empty to use the real current time in America/Campo_Grande.
STORE_REFERENCE_DATETIME=
